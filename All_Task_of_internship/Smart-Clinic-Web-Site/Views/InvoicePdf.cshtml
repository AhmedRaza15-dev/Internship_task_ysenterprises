@model Smart_Clinic_Web_site.Models.Invoice

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }
        
        .invoice-header {
            background: #3b82f6;
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        .invoice-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .invoice-info {
            background: #f9fafb;
            padding: 25px;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .patient-info, .invoice-details {
            margin-bottom: 25px;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        
        .invoice-items {
            padding: 25px;
        }
        
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .items-table th {
            background: #f3f4f6;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #e5e7eb;
        }
        
        .items-table td {
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .summary {
            background: #f9fafb;
            padding: 25px;
            border-top: 1px solid #e5e7eb;
        }
        
        .summary-grid {
            max-width: 300px;
            margin-left: auto;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .total-row {
            font-size: 18px;
            font-weight: bold;
            padding-top: 15px;
            border-top: 2px solid #e5e7eb;
        }
        
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
        }
        
        .paid { background: #d1fae5; color: #065f46; }
        .pending { background: #fef3c7; color: #92400e; }
        
        .footer {
            text-align: center;
            padding: 20px;
            background: #111827;
            color: white;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Header -->
        <div class="invoice-header">
            <div class="invoice-title">INVOICE</div>
            <div style="font-size: 24px; font-weight: 600;">@Model.InvoiceNumber</div>
            <div style="margin-top: 10px; font-size: 16px;">
                <span class="status-badge @Model.Status.ToLower()">@Model.Status</span>
            </div>
        </div>

        <!-- Clinic Information -->
        <div style="padding: 25px; background: white;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
                <div>
                    <h2 style="margin: 0 0 10px 0; color: #3b82f6;">Smart Clinic System</h2>
                    <p style="margin: 5px 0;">123 Medical Center Drive</p>
                    <p style="margin: 5px 0;">Healthcare City, HC 12345</p>
                    <p style="margin: 5px 0;">Phone: (123) 456-7890</p>
                    <p style="margin: 5px 0;">Email: billing@smartclinic.com</p>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 18px; font-weight: 600; margin-bottom: 10px;">Date Issued:</div>
                    <div style="font-size: 16px;">@Model.IssueDate.ToString("MMM dd, yyyy")</div>
                    <div style="font-size: 18px; font-weight: 600; margin: 15px 0 10px 0;">Due Date:</div>
                    <div style="font-size: 16px;">@Model.DueDate.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Invoice Info -->
        <div class="invoice-info">
            <div class="info-grid">
                <div class="patient-info">
                    <h3 style="margin: 0 0 15px 0; color: #374151;">Bill To:</h3>
                    <div style="background: white; padding: 15px; border-radius: 6px;">
                        <p style="margin: 5px 0; font-weight: 600;">@Model.Patient.FullName</p>
                        <p style="margin: 5px 0;">@Model.Patient.Address</p>
                        <p style="margin: 5px 0;">@Model.Patient.Email</p>
                        <p style="margin: 5px 0;">@Model.Patient.PhoneNumber</p>
                        <p style="margin: 5px 0;">Medical Record: @Model.Patient.MedicalRecordNumber</p>
                    </div>
                </div>
                <div class="invoice-details">
                    <h3 style="margin: 0 0 15px 0; color: #374151;">Invoice Details:</h3>
                    <div style="background: white; padding: 15px; border-radius: 6px;">
                        <p style="margin: 8px 0;"><strong>Invoice #:</strong> @Model.InvoiceNumber</p>
                        <p style="margin: 8px 0;"><strong>Issue Date:</strong> @Model.IssueDate.ToString("MMM dd, yyyy")</p>
                        <p style="margin: 8px 0;"><strong>Due Date:</strong> @Model.DueDate.ToString("MMM dd, yyyy")</p>
                        <p style="margin: 8px 0;"><strong>Cashier:</strong> @Model.Cashier?.FullName</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Items -->
        <div class="invoice-items">
            <h3 style="margin: 0 0 20px 0; color: #374151;">Invoice Items</h3>
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td>
                                <span style="background: #dbeafe; color: #1e40af; padding: 2px 8px; border-radius: 12px; font-size: 12px;">
                                    @item.Category
                                </span>
                            </td>
                            <td>$@item.UnitPrice.ToString("F2")</td>
                            <td>@item.Quantity</td>
                            <td>$@item.Amount.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Summary -->
        <div class="summary">
            <div class="summary-grid">
                <div class="summary-row">
                    <span>Subtotal:</span>
                    <span>$@Model.SubTotal.ToString("F2")</span>
                </div>
                <div class="summary-row">
                    <span>Tax (10%):</span>
                    <span>$@Model.TaxAmount.ToString("F2")</span>
                </div>
                <div class="summary-row total-row">
                    <span>Total Amount:</span>
                    <span style="color: #3b82f6;">$@Model.TotalAmount.ToString("F2")</span>
                </div>
            </div>
        </div>

        @if (Model.Status == "Paid")
        {
            <div style="padding: 25px; background: #d1fae5; border-top: 1px solid #e5e7eb;">
                <h3 style="margin: 0 0 15px 0; color: #065f46;">Payment Information</h3>
                <div style="background: white; padding: 15px; border-radius: 6px;">
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
                        <div>
                            <p style="margin: 5px 0;"><strong>Payment Date:</strong></p>
                            <p style="margin: 5px 0;">@Model.PaymentDate?.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                        <div>
                            <p style="margin: 5px 0;"><strong>Payment Method:</strong></p>
                            <p style="margin: 5px 0;">@Model.PaymentMethod</p>
                        </div>
                        <div>
                            <p style="margin: 5px 0;"><strong>Transaction ID:</strong></p>
                            <p style="margin: 5px 0;">TXN-@Model.Id.ToString("D8")</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="padding: 25px; background: #fef3c7; border-top: 1px solid #e5e7eb;">
                <h3 style="margin: 0 0 10px 0; color: #92400e;">Notes</h3>
                <p style="margin: 0;">@Model.Notes</p>
            </div>
        }

        <!-- Footer -->
        <div class="footer">
            <p style="margin: 5px 0;">Smart Clinic System | 123 Medical Center Drive | Healthcare City, HC 12345</p>
            <p style="margin: 5px 0; opacity: 0.8;">Phone: (123) 456-7890 | Email: info@smartclinic.com</p>
            <p style="margin: 5px 0; opacity: 0.8;">This is a computer-generated invoice. No signature required.</p>
        </div>
    </div>
</body>
</html>
