@model List<Smart_Clinic_Web_site.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">My Prescriptions</h1>
            <p class="mt-2 text-gray-600">View all your prescriptions from our doctors</p>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <!-- Active Prescriptions -->
            @if (Model.Where(p => p.Status == "Active").Count() > 0)
            {
                <div class="mb-8">
                    <h2 class="text-xl font-bold text-gray-900 mb-4">Active Prescriptions</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var prescription in Model.Where(p => p.Status == "Active"))
                        {
                            <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500 hover:shadow-lg transition">
                                <div class="flex items-start justify-between mb-4">
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-900">@prescription.MedicineName</h3>
                                        <p class="text-sm text-gray-500">Prescribed by @prescription.DoctorName</p>
                                    </div>
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                        Active
                                    </span>
                                </div>

                                <div class="space-y-2 mb-4 bg-gray-50 p-4 rounded">
                                    <div class="flex justify-between">
                                        <span class="text-gray-600 text-sm">Dosage:</span>
                                        <span class="font-medium text-gray-900">@prescription.Dosage</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600 text-sm">Frequency:</span>
                                        <span class="font-medium text-gray-900">@prescription.Frequency</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600 text-sm">Duration:</span>
                                        <span class="font-medium text-gray-900">@prescription.Duration</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600 text-sm">Issued Date:</span>
                                        <span class="font-medium text-gray-900">@prescription.IssuedDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div class="flex gap-2 pt-4 border-t border-gray-200">
                                    <a href="@Url.Action("PrescriptionDetails", "Patient", new { id = prescription.Id })" 
                                       onclick="console.log('Viewing prescription details for: ' + @prescription.Id)"
                                       class="flex-1 px-3 py-2 border border-blue-300 text-blue-600 text-sm font-medium rounded-md hover:bg-blue-50 text-center">
                                        View Details
                                    </a>
                                    <button onclick="console.log('Refilling prescription: ' + '@prescription.MedicineName')"
                                            class="flex-1 px-3 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700">
                                        Request Refill
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Expired Prescriptions -->
            @if (Model.Where(p => p.Status == "Expired").Count() > 0)
            {
                <div class="mb-8">
                    <h2 class="text-xl font-bold text-gray-900 mb-4">Expired Prescriptions</h2>
                    <div class="bg-white shadow-md rounded-lg overflow-hidden">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Medicine</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dosage</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doctor</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Issued Date</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var prescription in Model.Where(p => p.Status == "Expired"))
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm font-medium text-gray-900">@prescription.MedicineName</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-900">@prescription.Dosage</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-900">@prescription.DoctorName</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-900">@prescription.IssuedDate.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                                Expired
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <button onclick="console.log('Requesting new prescription from doctor')"
                                                    class="text-blue-600 hover:text-blue-900 font-medium">
                                                Request New
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white rounded-lg shadow-md p-12 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <h3 class="text-lg font-medium text-gray-900 mb-2">No Prescriptions</h3>
                <p class="text-gray-600">You don't have any prescriptions yet. Book an appointment with a doctor to get a prescription.</p>
            </div>
        }

        <!-- Information Card -->
        <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-blue-900 mb-3">Prescription Guidelines</h3>
            <ul class="space-y-2 text-blue-800">
                <li class="flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Follow the dosage and frequency exactly as prescribed</span>
                </li>
                <li class="flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Request a refill before your prescription expires</span>
                </li>
                <li class="flex items-start">
                    <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>Contact your doctor if you experience any side effects</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('View Prescriptions Page Loaded');
        console.log('Total Prescriptions:', @Model?.Count ?? 0);
        console.log('Active Prescriptions:', @Model?.Where(p => p.Status == "Active").Count() ?? 0);
        console.log('Expired Prescriptions:', @Model?.Where(p => p.Status == "Expired").Count() ?? 0);
    });
</script>
