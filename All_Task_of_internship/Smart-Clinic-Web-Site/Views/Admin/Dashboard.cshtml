@{
    // Dummy data for dashboard (used when controller doesn't provide a model)
    var appointmentData = new[] {
        new { Day = "Mon", Height = 60 },
        new { Day = "Tue", Height = 75 },
        new { Day = "Wed", Height = 50 },
        new { Day = "Thu", Height = 85 },
        new { Day = "Fri", Height = 40 },
        new { Day = "Sat", Height = 30 },
        new { Day = "Sun", Height = 20 }
    };

    var recentActivities = new[] {
        new { Icon = "user-plus", Color = "blue", Description = "New patient registered", Details = "John Doe • 30 min ago" },
        new { Icon = "file-medical", Color = "green", Description = "Medical record updated", Details = "Dr. Smith • 2 hours ago" },
        new { Icon = "calendar-check", Color = "purple", Description = "Appointment scheduled", Details = "For tomorrow, 10:00 AM" }
    };

    var upcomingAppointments = new[] {
        new { PatientName = "Michael Chen", PatientId = "#P-10234", DoctorName = "Dr. Emily Wilson", Time = "Today, 11:30 AM", Status = "Confirmed", StatusColor = "blue", Action = "View Details" },
        new { PatientName = "Jennifer Parker", PatientId = "#P-10235", DoctorName = "Dr. Robert Brown", Time = "Today, 2:00 PM", Status = "Pending", StatusColor = "yellow", Action = "Confirm" }
    };

    var doctorAvailability = new[] {
        new { Name = "Dr. Sarah Johnson", Specialization = "General Physician", IsAvailable = true },
        new { Name = "Dr. Robert Brown", Specialization = "Cardiologist", IsAvailable = false }
    };

    var emergencyContacts = new[] {
        new { Name = "Emergency Ward", Department = "Emergency", Phone = "911", Icon = "ambulance" },
        new { Name = "Pharmacy", Department = "Medications", Phone = "+1-555-0124", Icon = "pills" }
    };
}

<div class="p-6">
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white mb-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold">Welcome back, Dr. Johnson</h1>
                <p class="mt-2 opacity-90">Here's what's happening with your clinic today.</p>
            </div>
            <div class="mt-4 md:mt-0">
                <span class="text-sm bg-white text-blue-600 px-4 py-2 rounded-lg font-medium">Last updated: Today at 10:30 AM</span>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Patients Card -->
        <div class="bg-white rounded-xl shadow-md p-6 card-hover border-l-4 border-blue-500">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-500 text-sm">Total Patients</p>
                    <h3 class="text-2xl font-bold mt-2">1,247</h3>
                    <p class="text-green-600 text-sm mt-1">
                        <span class="fas fa-arrow-up mr-1"></span> 12% from last month
                    </p>
                </div>
                <div class="p-3 bg-blue-100 rounded-lg">
                    <svg class="w-8 h-8 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Active Doctors Card -->
        <div class="bg-white rounded-xl shadow-md p-6 card-hover border-l-4 border-green-500">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-500 text-sm">Active Doctors</p>
                    <h3 class="text-2xl font-bold mt-2">24</h3>
                    <p class="text-green-600 text-sm mt-1">
                        <span class="fas fa-user-check mr-1"></span> All available
                    </p>
                </div>
                <div class="p-3 bg-green-100 rounded-lg">
                    <svg class="w-8 h-8 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Today's Appointments Card -->
        <div class="bg-white rounded-xl shadow-md p-6 card-hover border-l-4 border-purple-500">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-500 text-sm">Today's Appointments</p>
                    <h3 class="text-2xl font-bold mt-2">42</h3>
                    <p class="text-red-600 text-sm mt-1">
                        <span class="fas fa-clock mr-1"></span> 3 pending
                    </p>
                </div>
                <div class="p-3 bg-purple-100 rounded-lg">
                    <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="bg-white rounded-xl shadow-md p-6 card-hover border-l-4 border-yellow-500">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-500 text-sm">Monthly Revenue</p>
                    <h3 class="text-2xl font-bold mt-2">$42,580</h3>
                    <p class="text-green-600 text-sm mt-1">
                        <span class="fas fa-arrow-up mr-1"></span> 8.5% increase
                    </p>
                </div>
                <div class="bg-yellow-100 p-3 rounded-lg">
                    <span class="fas fa-dollar-sign text-yellow-600 text-xl"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Tables Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Appointments Chart -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-md p-6">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-semibold">Weekly Appointments</h3>
                <select class="border rounded-lg px-3 py-1 text-sm" id="selectedTimePeriod" name="selectedTimePeriod">
                    <option value="week">This Week</option>
                    <option value="lastWeek">Last Week</option>
                    <option value="month">This Month</option>
                </select>
            </div>
            @{
                // Prepare SVG line chart points from appointmentData
                var svgWidth = 700; // viewBox width
                var svgHeight = 120; // viewBox height
                var maxVal = 100.0;
                var n = appointmentData.Length;
                var step = n > 1 ? (double)svgWidth / (n - 1) : svgWidth;
                var points = new List<string>();
                for (int i = 0; i < n; i++)
                {
                    var h = (double)appointmentData[i].Height;
                    var x = step * i;
                    var y = svgHeight - (h / maxVal * svgHeight);
                    points.Add($"{x},{y}");
                }
                var pointsAttr = string.Join(" ", points);
            }

            <div class="w-full">
                <svg viewBox="0 0 @svgWidth @svgHeight" preserveAspectRatio="none" class="w-full h-64">
                    <!-- area fill -->
                    <polyline points="@pointsAttr" fill="rgba(59,130,246,0.08)" stroke="none"/>
                    <!-- line -->
                    <polyline points="@pointsAttr" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
                    <!-- markers -->
                    @for (int i = 0; i < n; i++)
                    {
                        var p = points[i].Split(',');
                        <circle cx="@p[0]" cy="@p[1]" r="3.5" fill="#1e40af" />
                    }
                </svg>
            </div>
            <div class="flex justify-between mt-2 text-xs text-gray-500 px-2">
                @foreach (var d in appointmentData)
                {
                    <span>@d.Day</span>
                }
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold mb-6">Recent Activity</h3>
            <div class="space-y-4">
                @{
                    var bootstrapIcons = new Dictionary<string, (string iconClass, string bgColor, string textColor)>
                    {
                        { "user-plus", ("fas fa-user-plus", "bg-blue-100", "text-blue-600") },
                        { "file-medical", ("fas fa-file-medical", "bg-green-100", "text-green-600") },
                        { "calendar-check", ("fas fa-calendar-check", "bg-purple-100", "text-purple-600") },
                        { "prescription", ("fas fa-prescription-bottle-medical", "bg-yellow-100", "text-yellow-600") },
                        { "ambulance", ("fas fa-ambulance", "bg-red-100", "text-red-600") }
                    };
                }
                
                @foreach (var activity in recentActivities)
                {
                    var iconData = bootstrapIcons[activity.Icon];
                    <div class="flex items-start">
                        <div class="p-2 rounded-lg mr-3 @iconData.bgColor">
                            <span class="@iconData.iconClass @iconData.textColor"></span>
                        </div>
                        <div>
                            <p class="text-sm font-medium">@activity.Description</p>
                            <p class="text-xs text-gray-500">@activity.Details</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Upcoming Appointments Table -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold">Upcoming Appointments</h3>
            <button type="button" class="text-blue-600 font-medium text-sm">View All</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-gray-500 text-sm border-b">
                        <th class="pb-3">Patient</th>
                        <th class="pb-3">Doctor</th>
                        <th class="pb-3">Time</th>
                        <th class="pb-3">Status</th>
                        <th class="pb-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in upcomingAppointments)
                    {
                        var statusColors = new Dictionary<string, (string bgColor, string textColor)>
                        {
                            { "Confirmed", appointment.StatusColor == "blue" ? ("bg-blue-100", "text-blue-800") : ("bg-green-100", "text-green-800") },
                            { "Pending", ("bg-yellow-100", "text-yellow-800") }
                        };
                        var colors = statusColors[appointment.Status];
                        // Assign explicit profile images for demo purposes since they aren't in the model
                        var profileImage = appointment.PatientName.Contains("Michael") 
                            ? "https://randomuser.me/api/portraits/men/32.jpg" 
                            : "https://randomuser.me/api/portraits/women/44.jpg";
                        
                        <tr class="border-b hover:bg-gray-50">
                            <td class="py-4">
                                <div class="flex items-center">
                                    <img class="w-10 h-10 rounded-full mr-3 border border-gray-200" src="@profileImage" alt="@appointment.PatientName">
                                    <div>
                                        <p class="font-medium">@appointment.PatientName</p>
                                        <p class="text-xs text-gray-500">ID: @appointment.PatientId</p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4">@appointment.DoctorName</td>
                            <td class="py-4">@appointment.Time</td>
                            <td class="py-4">
                                <span class="px-3 py-1 rounded-full text-xs @colors.bgColor @colors.textColor">
                                    @appointment.Status
                                </span>
                            </td>
                            <td class="py-4">
                                <button type="button" class="text-blue-600 text-sm font-medium">
                                    @appointment.Action
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Actions Panel -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold mb-4">Quick Actions</h3>
            <div class="space-y-3">
                <button type="button" class="w-full text-left p-3 rounded-lg border hover:bg-blue-50 hover:border-blue-300 transition">
                    <span class="fas fa-user-plus text-blue-600 mr-3"></span>
                    <span>Add New Patient</span>
                </button>
                <button type="button" class="w-full text-left p-3 rounded-lg border hover:bg-green-50 hover:border-green-300 transition">
                    <span class="fas fa-calendar-plus text-green-600 mr-3"></span>
                    <span>Schedule Appointment</span>
                </button>
                <button type="button" class="w-full text-left p-3 rounded-lg border hover:bg-purple-50 hover:border-purple-300 transition">
                    <span class="fas fa-chart-bar text-purple-600 mr-3"></span>
                    <span>Generate Report</span>
                </button>
            </div>
        </div>

        <!-- Doctor Availability -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold mb-4">Doctor Availability</h3>
            <div class="space-y-4">
                @foreach (var doctor in doctorAvailability)
                {
                    var statusClass = doctor.IsAvailable ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800";
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mr-3">
                                <span class="fas fa-id-badge text-blue-600"></span>
                            </div>
                            <div>
                                <p class="font-medium text-sm">@doctor.Name</p>
                                <p class="text-xs text-gray-500">@doctor.Specialization</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs @statusClass">
                            @(doctor.IsAvailable ? "Available" : "Busy")
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Emergency Contacts -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-semibold mb-4">Emergency Contacts</h3>
            <div class="space-y-4">
                @{
                    var contactIcons = new Dictionary<string, string>
                    {
                        { "ambulance", "fas fa-ambulance" },
                        { "pills", "fas fa-pills" },
                        { "user-md", "fas fa-user-md" },
                        { "flask", "fas fa-flask" }
                    };
                }
                
                @foreach (var contact in emergencyContacts)
                {
                    var iconClass = contactIcons.ContainsKey(contact.Icon) ? contactIcons[contact.Icon] : "fas fa-phone";
                    <div class="flex items-center justify-between p-3 rounded-lg border hover:bg-red-50 transition">
                        <div class="flex items-center">
                            <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center mr-3">
                                <span class="@iconClass text-red-600"></span>
                            </div>
                            <div>
                                <p class="font-medium text-sm">@contact.Name</p>
                                <p class="text-xs text-gray-500">@contact.Department</p>
                            </div>
                        </div>
                        <a href="tel:@contact.Phone" class="text-red-600 hover:text-red-800">
                            <span class="fas fa-phone"></span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease-in-out;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
</style>
