@{
    ViewData["Title"] = "Our Doctors";
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-center mb-8 text-gray-800 dark:text-white">Our Doctors</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Doctor Card 1 -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="p-6">
                <div class="w-24 h-24 mx-auto mb-4 bg-blue-100 rounded-full flex items-center justify-center">
                    <svg class="w-12 h-12 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-center mb-2 text-gray-800 dark:text-white">Dr. Sarah Johnson</h3>
                <p class="text-blue-600 text-center mb-4">Cardiologist</p>
                <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">
                    Specialized in heart disease treatment with 15+ years of experience.
                </p>
                <div class="text-center">
                    <a href="@Url.Action("BookAppointment", "Doctor", new { doctorId = 1, doctorName = "Dr. Sarah Johnson" })" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                        Book Appointment
                    </a>
                </div>
            </div>
        </div>

