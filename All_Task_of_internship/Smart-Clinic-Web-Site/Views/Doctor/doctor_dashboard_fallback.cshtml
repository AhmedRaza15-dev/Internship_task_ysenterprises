@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <aside class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Doctor Menu</h5>
                    <nav class="nav flex-column">
                        <a class="nav-link" asp-controller="Doctor" asp-action="Dashboard">Overview</a>
                        <a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a>
                        <a class="nav-link" asp-controller="Patients" asp-action="Index">My Patients</a>
                        <a class="nav-link" asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                        <a class="nav-link" asp-controller="Prescriptions" asp-action="Index">E-Prescriptions</a>
                        <a class="nav-link" asp-controller="Messages" asp-action="Index">Messages</a>
                    </nav>
                </div>
            </div>
        </aside>

        <main class="col-md-9">
            <div class="card">
                <div class="card-body">
                    <h2>Doctor Dashboard (Fallback)</h2>
                    <p>This is a server-side fallback dashboard so the navbar link works immediately.
                    The full interactive dashboard in the repository is implemented as a Blazor component.
                    If you want the Blazor version to serve here, I can enable Blazor Server hosting or convert
                    the component to a MVC view. For now this provides a usable placeholder and a sidebar
                    with common doctor actions.</p>

                    <div class="mt-3">
                        <a class="btn btn-primary" asp-controller="Appointments" asp-action="Index">View Appointments</a>
                        <a class="btn btn-secondary" asp-controller="Patients" asp-action="Index">View Patients</a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
