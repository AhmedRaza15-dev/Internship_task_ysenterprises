@{
    ViewData["Title"] = "Doctor Dashboard";
    var doctorName = ViewData["DoctorName"]?.ToString() ?? "Doctor";
    var specialization = ViewData["Specialization"]?.ToString() ?? "";
    var rating = ViewData["Rating"]?.ToString() ?? "0";
    var reviewCount = ViewData["ReviewCount"]?.ToString() ?? "0";
    var email = ViewData["Email"]?.ToString() ?? "";
    var phone = ViewData["Phone"]?.ToString() ?? "";
    var status = ViewData["Status"]?.ToString() ?? "";
    var languages = ViewData["Languages"] as string[] ?? new string[0];
    var about = ViewData["About"]?.ToString() ?? "";
    var education = ViewData["Education"] as dynamic[] ?? new dynamic[0];
    var certifications = ViewData["Certifications"] as dynamic[] ?? new dynamic[0];
    var weeklySchedule = ViewData["WeeklySchedule"] as dynamic[] ?? new dynamic[0];
    var todayAppointments = ViewData["TodayAppointments"] as dynamic[] ?? new dynamic[0];
    var appointmentsPerDay = ViewData["AppointmentsPerDay"] as int[] ?? new int[0];
    var appointmentLabels = ViewData["AppointmentLabels"] as string[] ?? new string[0];
    var patientDemographics = ViewData["PatientDemographics"] as int[] ?? new int[0];
    var demographicLabels = ViewData["DemographicLabels"] as string[] ?? new string[0];
}

<style>
    /* Chart container styling */
    .chart-container {
        position: relative;
        height: 250px;
        min-height: 250px;
        width: 100%;
    }
    
    .chart-container canvas {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
    }
    
    /* Prevent layout shifts */
    #appointmentsChart, #demographicsChart {
        display: block !important;
    }
    
    /* Modal styling */
    #appointmentModal {
        transition: opacity 0.3s ease;
    }
    
    /* Medicine entry styling */
    .medicine-entry {
        transition: all 0.2s ease;
    }
    
    .medicine-entry:hover {
        background-color: rgba(243, 244, 246, 0.8);
    }
    
    .dark .medicine-entry:hover {
        background-color: rgba(55, 65, 81, 0.8);
    }
</style>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex">
    <!-- Sidebar Navigation -->
    <div class="w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex-shrink-0">
        <div class="p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Doctor Panel</h2>
            <nav class="space-y-2">
                <a href="@Url.Action("Dashboard", "Doctor")" class="flex items-center gap-3 px-4 py-3 bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 rounded-lg font-medium">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
                <a href="@Url.Action("Index", "Doctor")" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-user-doctor"></i>
                    <span>Doctor List</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-user-plus"></i>
                    <span>Add Doctor</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-calendar-check"></i>
                    <span>Appointments</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-users"></i>
                    <span>Patients</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-prescription"></i>
                    <span>Prescriptions</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
                    <i class="fas fa-file-medical"></i>
                    <span>Medical Records</span>
                </a>
            </nav>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 overflow-auto">
        <div class="p-6">
            <!-- Header -->
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Welcome, @doctorName</h1>
                <p class="text-gray-600 dark:text-gray-400">@specialization</p>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Total Patients</p>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">248</p>
                        </div>
                        <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
                            <i class="fas fa-users text-blue-600 dark:text-blue-400"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Today's Appointments</p>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">@todayAppointments.Length</p>
                        </div>
                        <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center">
                            <i class="fas fa-calendar-check text-green-600 dark:text-green-400"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Completed Today</p>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">@todayAppointments.Count(a => a.Status == "Completed")</p>
                        </div>
                        <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center">
                            <i class="fas fa-check-circle text-purple-600 dark:text-purple-400"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Rating</p>
                            <p class="text-2xl font-bold text-gray-900 dark:text-white">@rating ⭐</p>
                        </div>
                        <div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900 rounded-lg flex items-center justify-center">
                            <i class="fas fa-star text-yellow-600 dark:text-yellow-400"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Today's Appointments -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white">Today's Appointments</h2>
                    <button class="flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition">
                        <i class="fas fa-calendar"></i>
                        View Calendar
                    </button>
                </div>
                <div class="space-y-3">
                    @for (int i = 0; i < todayAppointments.Length; i++)
                    {
                        var appointment = todayAppointments[i];
                        <div class="flex justify-between items-center p-4 bg-gray-50 dark:bg-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 transition">
                            <div class="flex items-center gap-4">
                                <div class="text-center min-w-[80px]">
                                    <p class="text-lg font-bold text-gray-900 dark:text-white">@appointment.Time</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">@appointment.Type</p>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900 dark:text-white">@appointment.Patient</p>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Patient ID: #@(1000 + i)</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="px-3 py-1 text-sm rounded-full @(appointment.Status == "Completed" ? "bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200" : "bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200")">
                                    @appointment.Status
                                </span>
                                <button onclick="openAppointmentModal(@i)" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm transition">
                                    <i class="fas fa-eye mr-1"></i> View Details
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Weekly Appointments</h3>
                    <div class="chart-container">
                        <canvas id="appointmentsChart"></canvas>
                    </div>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Patient Demographics</h3>
                    <div class="chart-container">
                        <canvas id="demographicsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Appointment Details Modal -->
<div id="appointmentModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Appointment Details</h2>
            <button onclick="closeAppointmentModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <i class="fas fa-times text-2xl"></i>
            </button>
        </div>
        <div class="p-6">
            <!-- Patient Info -->
            <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Patient Information</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Patient Name</p>
                        <p id="modalPatientName" class="font-medium text-gray-900 dark:text-white"></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Appointment Time</p>
                        <p id="modalAppointmentTime" class="font-medium text-gray-900 dark:text-white"></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Type</p>
                        <p id="modalAppointmentType" class="font-medium text-gray-900 dark:text-white"></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Status</p>
                        <p id="modalAppointmentStatus" class="font-medium text-gray-900 dark:text-white"></p>
                    </div>
                </div>
            </div>

            <!-- Consultation Notes -->
            <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Consultation Notes</h3>
                <textarea id="consultationNotes" rows="4" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" placeholder="Enter consultation notes..."></textarea>
            </div>

            <!-- Prescription Form -->
            <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Prescribe Medicines</h3>
                <div id="medicinesList" class="space-y-3">
                    <!-- Medicine entries will be added here -->
                </div>
                <button onclick="addMedicine()" class="mt-3 px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg transition">
                    <i class="fas fa-plus mr-2"></i>Add Medicine
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-3">
                <button onclick="saveNotes()" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition">
                    <i class="fas fa-save mr-2"></i>Save Notes
                </button>
                <button onclick="generatePrescriptionPDF()" class="flex-1 px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition">
                    <i class="fas fa-file-pdf mr-2"></i>Generate Prescription PDF
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Appointment data
    const appointments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(todayAppointments));
    let currentAppointmentIndex = 0;
    let medicineCount = 0;
    let appointmentsChart = null;
    let demographicsChart = null;
    let chartInitialized = false;

    // Open appointment modal
    function openAppointmentModal(index) {
        currentAppointmentIndex = index;
        const appointment = appointments[index];
        
        document.getElementById('modalPatientName').textContent = appointment.Patient;
        document.getElementById('modalAppointmentTime').textContent = appointment.Time;
        document.getElementById('modalAppointmentType').textContent = appointment.Type;
        document.getElementById('modalAppointmentStatus').textContent = appointment.Status;
        
        document.getElementById('appointmentModal').classList.remove('hidden');
        document.getElementById('appointmentModal').classList.add('flex');
        
        // Clear previous data
        document.getElementById('consultationNotes').value = '';
        document.getElementById('medicinesList').innerHTML = '';
        medicineCount = 0;
        addMedicine(); // Add one medicine field by default
    }

    // Close appointment modal
    function closeAppointmentModal() {
        document.getElementById('appointmentModal').classList.add('hidden');
        document.getElementById('appointmentModal').classList.remove('flex');
    }

    // Add medicine field
    function addMedicine() {
        medicineCount++;
        const medicineHtml = `
            <div class="medicine-entry grid grid-cols-1 md:grid-cols-5 gap-3 p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
                <input type="text" placeholder="Medicine Name" class="medicine-name px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white">
                <input type="text" placeholder="Dosage" class="medicine-dosage px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white">
                <input type="text" placeholder="Frequency" class="medicine-frequency px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white">
                <input type="text" placeholder="Duration" class="medicine-duration px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white">
                <button onclick="this.parentElement.remove()" class="px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        `;
        document.getElementById('medicinesList').insertAdjacentHTML('beforeend', medicineHtml);
    }

    // Save consultation notes
    function saveNotes() {
        const notes = document.getElementById('consultationNotes').value;
        const medicines = [];
        
        document.querySelectorAll('.medicine-entry').forEach(entry => {
            const medicine = {
                name: entry.querySelector('.medicine-name').value,
                dosage: entry.querySelector('.medicine-dosage').value,
                frequency: entry.querySelector('.medicine-frequency').value,
                duration: entry.querySelector('.medicine-duration').value
            };
            if (medicine.name) medicines.push(medicine);
        });
        
        console.log('Consultation Notes:', notes);
        console.log('Prescribed Medicines:', medicines);
        
        alert('Notes and prescription saved successfully!');
    }

    // Generate Prescription PDF
    function generatePrescriptionPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const appointment = appointments[currentAppointmentIndex];
        const notes = document.getElementById('consultationNotes').value;
        
        // Header
        doc.setFontSize(20);
        doc.setFont(undefined, 'bold');
        doc.text('Smart Clinic', 105, 20, { align: 'center' });
        
        doc.setFontSize(12);
        doc.setFont(undefined, 'normal');
        doc.text('Medical Prescription', 105, 28, { align: 'center' });
        
        // Line separator
        doc.setLineWidth(0.5);
        doc.line(20, 32, 190, 32);
        
        // Doctor Information
        doc.setFontSize(11);
        doc.setFont(undefined, 'bold');
        doc.text('Doctor Information:', 20, 42);
        doc.setFont(undefined, 'normal');
        doc.text(`Name: @doctorName`, 20, 48);
        doc.text(`Specialization: @specialization`, 20, 54);
        doc.text(`Email: @email`, 20, 60);
        doc.text(`Phone: @phone`, 20, 66);
        
        // Patient Information
        doc.setFont(undefined, 'bold');
        doc.text('Patient Information:', 20, 76);
        doc.setFont(undefined, 'normal');
        doc.text(`Name: ${appointment.Patient}`, 20, 82);
        doc.text(`Date: ${new Date().toLocaleDateString()}`, 20, 88);
        doc.text(`Time: ${appointment.Time}`, 20, 94);
        doc.text(`Type: ${appointment.Type}`, 20, 100);
        
        // Consultation Notes
        if (notes) {
            doc.setFont(undefined, 'bold');
            doc.text('Consultation Notes:', 20, 110);
            doc.setFont(undefined, 'normal');
            const splitNotes = doc.splitTextToSize(notes, 170);
            doc.text(splitNotes, 20, 116);
        }
        
        // Prescribed Medicines
        let yPos = notes ? 130 + (notes.split('\\n').length * 5) : 110;
        doc.setFont(undefined, 'bold');
        doc.text('Prescribed Medicines:', 20, yPos);
        yPos += 6;
        
        doc.setFont(undefined, 'normal');
        const medicines = [];
        document.querySelectorAll('.medicine-entry').forEach(entry => {
            const medicine = {
                name: entry.querySelector('.medicine-name').value,
                dosage: entry.querySelector('.medicine-dosage').value,
                frequency: entry.querySelector('.medicine-frequency').value,
                duration: entry.querySelector('.medicine-duration').value
            };
            if (medicine.name) medicines.push(medicine);
        });
        
        if (medicines.length > 0) {
            medicines.forEach((med, index) => {
                doc.text(`${index + 1}. ${med.name}`, 25, yPos);
                yPos += 5;
                doc.text(`   Dosage: ${med.dosage} | Frequency: ${med.frequency} | Duration: ${med.duration}`, 25, yPos);
                yPos += 7;
            });
        } else {
            doc.text('No medicines prescribed', 25, yPos);
            yPos += 7;
        }
        
        // Footer
        yPos += 10;
        doc.setLineWidth(0.5);
        doc.line(20, yPos, 190, yPos);
        yPos += 8;
        doc.setFontSize(10);
        doc.text('Doctor Signature: _____________________', 20, yPos);
        doc.text(`Date: ${new Date().toLocaleDateString()}`, 120, yPos);
        
        // Save PDF
        doc.save(`Prescription_${appointment.Patient.replace(' ', '_')}_${new Date().toISOString().split('T')[0]}.pdf`);
        
        alert('Prescription PDF generated successfully!');
    }

    // Initialize Charts
    function initializeCharts() {
        // Destroy existing charts if they exist
        if (appointmentsChart) {
            appointmentsChart.destroy();
        }
        if (demographicsChart) {
            demographicsChart.destroy();
        }
        
        // Get chart contexts
        const appointmentsCanvas = document.getElementById('appointmentsChart');
        const demographicsCanvas = document.getElementById('demographicsChart');
        
        if (!appointmentsCanvas || !demographicsCanvas) {
            console.error('Chart canvases not found');
            return;
        }
        
        const appointmentsCtx = appointmentsCanvas.getContext('2d');
        const demographicsCtx = demographicsCanvas.getContext('2d');
        
        // Appointments Chart
        appointmentsChart = new Chart(appointmentsCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appointmentLabels)),
                datasets: [{
                    label: 'Appointments',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(appointmentsPerDay)),
                    backgroundColor: 'rgba(59, 130, 246, 0.5)',
                    borderColor: 'rgba(59, 130, 246, 1)',
                    borderWidth: 2,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 5
                        },
                        grid: {
                            display: true
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Demographics Chart
        demographicsChart = new Chart(demographicsCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(demographicLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(patientDemographics)),
                    backgroundColor: [
                        'rgba(59, 130, 246, 0.8)',
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(239, 68, 68, 0.8)',
                        'rgba(139, 92, 246, 0.8)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            usePointStyle: true,
                            boxWidth: 10
                        }
                    }
                },
                cutout: '60%'
            }
        });
        
        chartInitialized = true;
    }

    // Initialize charts when page loads
    document.addEventListener('DOMContentLoaded', function() {
        // Wait a bit for the DOM to fully render
        setTimeout(() => {
            initializeCharts();
        }, 100);
        
        // Add resize listener
        let resizeTimer;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function() {
                if (chartInitialized) {
                    initializeCharts();
                }
            }, 250);
        });
        
        // Close modal when clicking outside
        document.getElementById('appointmentModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAppointmentModal();
            }
        });
        
        // Initialize charts when they become visible (for better performance)
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !chartInitialized) {
                    initializeCharts();
                }
            });
        }, {
            threshold: 0.1
        });
        
        const chartContainers = document.querySelectorAll('.chart-container');
        chartContainers.forEach(container => {
            observer.observe(container);
        });
    });

    // Force chart re-initialization if needed (call this from console if issues persist)
    window.reinitializeCharts = function() {
        chartInitialized = false;
        initializeCharts();
    };
</script>