@{
    ViewData["Title"] = ViewData["PageTitle"] ?? "Doctor Specialization";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-4">Doctor Specializations</h1>
        <p class="text-gray-600 mb-6">List of medical specializations and sample doctors.</p>

        <div class="bg-white rounded-lg shadow p-6">
            <ul class="space-y-4">
                @{
                    var specs = ViewData["Specializations"] as string[] ?? new string[] { "Cardiology", "Orthopedics", "Neurology", "Pediatrics", "Dermatology", "Oncology" };
                }
                @foreach (var s in specs)
                {
                    <li class="flex items-center justify-between p-3 border rounded">
                        <div>
                            <div class="text-lg font-medium text-gray-900">@s</div>
                            <div class="text-sm text-gray-600">Sample doctors: Dr. Example A, Dr. Example B</div>
                        </div>
                        <a href="@Url.Action("Index", "Doctor", new { specialization = s })" class="px-3 py-1 bg-blue-600 text-white rounded">View</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
