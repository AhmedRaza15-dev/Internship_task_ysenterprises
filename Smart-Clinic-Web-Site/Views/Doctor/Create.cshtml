@model Smart_Clinic_Web_site.Models.Doctor

@{
    ViewBag.Title = "Add Doctor";
}

<div class="max-w-3xl mx-auto py-8">
    <h1 class="text-2xl font-bold mb-4">Add New Doctor</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-3 bg-green-50 border-l-4 border-green-400">
            <p class="text-green-700">@TempData["SuccessMessage"]</p>
        </div>
    }

    <form asp-controller="Doctor" asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div>
            <label class="block text-sm font-medium text-gray-700">Name</label>
            <input asp-for="Name" class="w-full px-3 py-2 border rounded" />
            <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Specialization</label>
            <input asp-for="Specialization" class="w-full px-3 py-2 border rounded" />
            <span asp-validation-for="Specialization" class="text-red-600 text-sm"></span>
        </div>

        <div class="flex items-center gap-3">
            <input asp-for="Available" type="checkbox" />
            <label class="text-sm">Available</label>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-controller="Doctor" asp-action="Index" class="px-4 py-2 border rounded">Cancel</a>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
