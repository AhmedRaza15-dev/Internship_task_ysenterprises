@model Smart_Clinic_Web_site.Models.Invoice

@{
    ViewBag.Title = "Invoice Details";
    // Console logging for navigation tracking
    <script>
        console.log('Invoice Details Page Loaded');
        console.log('Invoice Number: @Model.InvoiceNumber');
        console.log('Invoice ID: @Model.Id');
        console.log('Patient: @Model.Patient?.FullName');
        console.log('Status: @Model.Status');
        console.log('Total Amount: $@Model.TotalAmount.ToString("F2")');
    </script>
}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header with Actions -->
        <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center space-y-4 sm:space-y-0">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Invoice Details</h1>
                <p class="mt-2 text-gray-600">Invoice #@Model.InvoiceNumber</p>
            </div>
            <div class="flex space-x-3">
                <a href="@Url.Action("DownloadPdf", new { id = Model.Id })"
                   onclick="console.log('Downloading PDF for Invoice ID: @Model.Id')"
                   class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    Download PDF
                </a>
                <a href="@Url.Action("Edit", new { id = Model.Id })"
                   onclick="console.log('Navigating to Edit Invoice ID: @Model.Id')"
                   class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Edit Invoice
                </a>
            </div>
        </div>

        <div class="bg-white shadow-lg rounded-lg overflow-hidden">
            <!-- Invoice Header -->
            <div class="px-8 py-6 border-b border-gray-200">
                <div class="flex flex-col md:flex-row justify-between">
                    <div class="mb-6 md:mb-0">
                        <h2 class="text-2xl font-bold text-gray-900">Smart Clinic System</h2>
                        <p class="text-gray-600">123 Medical Center Drive</p>
                        <p class="text-gray-600">Healthcare City, HC 12345</p>
                        <p class="text-gray-600">Phone: (123) 456-7890</p>
                    </div>
                    <div class="text-right">
                        <h3 class="text-2xl font-bold text-blue-600">INVOICE</h3>
                        <div class="mt-2">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @(Model.Status == "Paid" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                @Model.Status
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoice Info -->
            <div class="px-8 py-6 bg-gray-50">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Patient Information -->
                    <div>
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Bill To:</h4>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <p class="font-medium text-gray-900">@Model.Patient.FullName</p>
                            <p class="text-gray-600">@Model.Patient.Address</p>
                            <p class="text-gray-600">@Model.Patient.Email</p>
                            <p class="text-gray-600">@Model.Patient.PhoneNumber</p>
                            <p class="text-gray-600 mt-2">MRN: @Model.Patient.MedicalRecordNumber</p>
                        </div>
                    </div>

                    <!-- Invoice Details -->
                    <div>
                        <h4 class="text-lg font-semibold text-gray-900 mb-3">Invoice Details:</h4>
                        <div class="bg-white p-4 rounded-lg border border-gray-200">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <p class="text-sm text-gray-600">Invoice Number:</p>
                                    <p class="font-medium">@Model.InvoiceNumber</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600">Issue Date:</p>
                                    <p class="font-medium">@Model.IssueDate.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600">Due Date:</p>
                                    <p class="font-medium">@Model.DueDate.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="text-sm text-gray-600">Cashier:</p>
                                    <p class="font-medium">@Model.Cashier?.FullName</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoice Items -->
            <div class="px-8 py-6">
                <h4 class="text-lg font-semibold text-gray-900 mb-4">Invoice Items</h4>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Description
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Category
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Unit Price
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Quantity
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Amount
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-gray-900">@item.Description</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-900">
                                        $@item.UnitPrice.ToString("F2")
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-900">
                                        @item.Quantity
                                    </td>
                                    <td class="px-6 py-4 text-sm font-medium text-gray-900">
                                        $@item.Amount.ToString("F2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Summary -->
            <div class="px-8 py-6 bg-gray-50">
                <div class="flex justify-end">
                    <div class="w-64">
                        <div class="space-y-3">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Subtotal:</span>
                                <span class="font-medium">$@Model.SubTotal.ToString("F2")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Tax (10%):</span>
                                <span class="font-medium">$@Model.TaxAmount.ToString("F2")</span>
                            </div>
                            <div class="flex justify-between pt-3 border-t border-gray-200 text-lg font-bold">
                                <span>Total Amount:</span>
                                <span class="text-blue-600">$@Model.TotalAmount.ToString("F2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Information -->
            @if (Model.Status == "Paid")
            {
                <div class="px-8 py-6 border-t border-gray-200">
                    <h4 class="text-lg font-semibold text-gray-900 mb-3">Payment Information</h4>
                    <div class="bg-green-50 p-4 rounded-lg">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <p class="text-sm text-gray-600">Payment Date:</p>
                                <p class="font-medium">@Model.PaymentDate?.ToString("MMM dd, yyyy hh:mm tt")</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600">Payment Method:</p>
                                <p class="font-medium">@Model.PaymentMethod</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600">Transaction ID:</p>
                                <p class="font-medium">TXN-@Model.Id.ToString("D8")</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Notes -->
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="px-8 py-6 border-t border-gray-200 bg-yellow-50">
                    <h4 class="text-lg font-semibold text-gray-900 mb-3">Notes</h4>
                    <p class="text-gray-700">@Model.Notes</p>
                </div>
            }

            <!-- Footer -->
            <div class="px-8 py-4 bg-gray-900 text-white">
                <div class="text-center">
                    <p class="text-sm">Thank you for choosing Smart Clinic System</p>
                    <p class="text-sm opacity-75">This is a computer-generated invoice. No signature required.</p>
                </div>
            </div>
        </div>
    </div>
</div>
