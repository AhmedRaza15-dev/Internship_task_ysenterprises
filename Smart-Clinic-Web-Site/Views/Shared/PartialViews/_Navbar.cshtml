<header class="bg-white dark:bg-gray-800 shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            <!-- Logo -->
            <a class="text-2xl font-bold text-blue-600" asp-controller="Home" asp-action="Index">Smart Clinic</a>

            <!-- Links -->
            <div class="hidden md:flex space-x-6 items-center">
                <a class="hover:text-blue-500" asp-controller="Home" asp-action="Index">Home</a>
                <a class="hover:text-blue-500" asp-controller="Doctor" asp-action="Index">Doctors</a>
                <a class="hover:text-blue-500" asp-controller="Appointments" asp-action="Index">Appointments</a>
                
                <!-- Dashboards Dropdown -->
                <div class="relative group">
                    <button class="hover:text-blue-500 flex items-center gap-1">
                        Dashboards
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </button>
                    <div class="absolute left-0 mt-0 w-48 bg-white dark:bg-gray-700 shadow-lg rounded-md hidden group-hover:block z-50">
                        <a asp-controller="Admin" asp-action="Dashboard" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">Admin Dashboard</a>
                        <a href="@Url.Action("Dashboard", "Doctor")" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">Doctor Dashboard</a>
                        <a href="@Url.Action("Dashboard", "Patient")" onclick="console.log('Navigating to Patient Dashboard')" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">Patient Dashboard</a>
                        <hr class="my-1 dark:border-gray-600" />
                        <a href="@Url.Action("Create", "Invoice")" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">Create Invoice</a>
                        @inject Smart_Clinic_Web_site.Models.ApplicationDbContext _context
                        @{
                            var lastInv = _context.Invoices.LastOrDefault();
                            var sampleInvId = lastInv != null ? lastInv.Id : 1;
                        }
                        <a href="@Url.Action("Details", "Invoice", new { id = sampleInvId })" id="navbar-view-invoice" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">View Invoice</a>
                        <a href="@Url.Action("DownloadPdf", "Invoice", new { id = sampleInvId })" id="navbar-download-invoice" class="block px-4 py-2 hover:bg-blue-100 dark:hover:bg-gray-600 text-sm">Download Invoice PDF</a>
                    </div>
                </div>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-gray-600">Welcome, @User.Identity.Name</span>
                    <a class="hover:text-blue-500" asp-controller="Auth" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="hover:text-blue-500" asp-controller="Auth" asp-action="Login">Login</a>
                    <a class="hover:text-blue-500" asp-controller="Auth" asp-action="Register">Register</a>
                }

            </div>

            <!-- Mobile Menu Button -->
            <div class="md:hidden">
                <button id="mobile-menu-button" class="text-gray-700 dark:text-gray-200 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-1 bg-white dark:bg-gray-800">
        <a class="block hover:text-blue-500 py-2" asp-controller="Home" asp-action="Index">Home</a>
        <a class="block hover:text-blue-500 py-2" asp-controller="Doctor" asp-action="Index">Doctors</a>
        <a class="block hover:text-blue-500 py-2" asp-controller="Appointments" asp-action="Index">Appointments</a>
        
        <!-- Mobile Dashboards Menu -->
        <div class="py-2">
            <button id="mobile-dashboards-button" class="w-full text-left hover:text-blue-500 flex items-center gap-1 py-2">
                Dashboards
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </button>
                <div id="mobile-dashboards-menu" class="hidden bg-gray-100 dark:bg-gray-700 rounded pl-4 space-y-1 mt-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="block hover:text-blue-500 py-2 text-sm">Admin Dashboard</a>
                <a href="@Url.Action("Dashboard", "Doctor")" class="block hover:text-blue-500 py-2 text-sm">Doctor Dashboard</a>
                <a href="@Url.Action("Dashboard", "Patient")" onclick="console.log('Navigating to Patient Dashboard from mobile menu')" class="block hover:text-blue-500 py-2 text-sm">Patient Dashboard</a>
                <hr class="my-1 dark:border-gray-600" />
                <a href="@Url.Action("Create", "Invoice")" class="block hover:text-blue-500 py-2 text-sm">Create Invoice</a>
                <a href="@Url.Action("Details", "Invoice", new { id = 1 })" class="block hover:text-blue-500 py-2 text-sm">View Invoice</a>
                <a href="@Url.Action("DownloadPdf", "Invoice", new { id = 1 })" class="block hover:text-blue-500 py-2 text-sm">Download Invoice PDF</a>
            </div>
        </div>
        
        <a class="block hover:text-blue-500 py-2" asp-controller="Auth" asp-action="Login">Login</a>
        <a class="block hover:text-blue-500 py-2" asp-controller="Auth" asp-action="Register">Register</a>
    </div>
</header>

<script>
    const menuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const dashboardsButton = document.getElementById('mobile-dashboards-button');
    const dashboardsMenu = document.getElementById('mobile-dashboards-menu');

    menuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });

    if (dashboardsButton) {
        dashboardsButton.addEventListener('click', () => {
            dashboardsMenu.classList.toggle('hidden');
        });
    }
</script>
