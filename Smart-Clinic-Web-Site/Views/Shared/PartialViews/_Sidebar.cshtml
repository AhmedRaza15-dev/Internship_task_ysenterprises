@{
    // Show all menus by default for now (no authentication required for testing)
    // In production, you would check User.IsInRole("RoleName") after setting up Identity
    var showAdminMenu = true;
    var showDoctorMenu = true;
    var showPatientMenu = true;
    var showBillingMenu = true;
}

@inject Smart_Clinic_Web_site.Models.ApplicationDbContext _context
@{
    var lastInvoice = _context.Invoices.LastOrDefault();
    var sampleInvoiceId = lastInvoice != null ? lastInvoice.Id : 1;
}

<aside id="sidebar" class="bg-gray-100 dark:bg-gray-800 border-r dark:border-gray-700 transition-all duration-300 ease-in-out flex flex-col w-64 fixed md:relative z-30 hidden md:flex h-full"> <!-- Removed h-screen, kept h-full -->
    <!-- Header / Toggle -->
    <div class="p-4 flex items-center justify-between h-16 dark:border-gray-700 border-b flex-shrink-0">
        <h2 class="font-bold text-lg sidebar-text whitespace-nowrap overflow-hidden transition-all duration-300">Smart Clinic</h2>
        <button id="sidebar-toggle" class="p-2 rounded-md border border-black bg-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none flex-shrink-0">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <!-- Scrollable Content -->
    <div class="flex-1 overflow-y-auto overflow-x-hidden p-2 space-y-6">
        
        <!-- Admin Menu -->
        @if (showAdminMenu)
        {
            <div class="sidebar-section">
                <h3 class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider sidebar-header mb-2 transition-opacity duration-300 whitespace-nowrap">Admin</h3>
                <ul class="space-y-1">
                    <li>
                        <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Admin Dashboard">
                            <i class="fas fa-tachometer-alt w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Patient" asp-action="Dashboard" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Manage Patients">
                            <i class="fas fa-users w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Manage Patients</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Doctor" asp-action="Index" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Manage Doctors">
                            <i class="fas fa-user-md w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Manage Doctors</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="View Reports">
                            <i class="fas fa-chart-bar w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">View Reports</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <!-- Doctor Menu -->
        @if (showDoctorMenu)
        {
            <div class="sidebar-section">
                <h3 class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider sidebar-header mb-2 transition-opacity duration-300 whitespace-nowrap">Doctor</h3>
                <ul class="space-y-1">
                    <li>
                        <a asp-controller="Doctor" asp-action="Create" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Add Doctor">
                            <i class="fas fa-user-plus w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Add Doctor</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Doctor")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Doctor List">
                            <i class="fas fa-user-doctor w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Doctor List</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Doctor/Schedule" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Doctor Schedule">
                            <i class="fas fa-calendar-days w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Doctor Schedule</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Doctor/Specialization" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Specialization">
                            <i class="fas fa-stethoscope w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Specialization</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        
        <!-- Patient Menu -->
        @if (showPatientMenu)
        {
            <div class="sidebar-section">
                <h3 class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider sidebar-header mb-2 transition-opacity duration-300 whitespace-nowrap">Patient</h3>
                <ul class="space-y-1">
                    <li>
                        <a href="@Url.Action("Dashboard", "Patient")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Patient Dashboard">
                            <i class="fas fa-chart-line w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("ViewPrescriptions", "Patient")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="View Prescriptions">
                            <i class="fas fa-pills w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">View Prescriptions</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

        <!-- Appointment Menu (Moved from Patient) -->
        <div class="sidebar-section">
            <h3 class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider sidebar-header mb-2 transition-opacity duration-300 whitespace-nowrap">Appointment</h3>
            <ul class="space-y-1">
                <li>
                    <a href="@Url.Action("MyAppointments", "Patient")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="My Appointments">
                        <i class="fas fa-calendar-check w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                        <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">My Appointments</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("BookAppointment", "Patient")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Book Appointment">
                        <i class="fas fa-plus-circle w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                        <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Book Appointment</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Invoice Menu -->
        @if (showBillingMenu)
        {
            <div class="sidebar-section">
                <h3 class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider sidebar-header mb-2 transition-opacity duration-300 whitespace-nowrap">Invoice</h3>
                <ul class="space-y-1">
                    <li>
                        <a href="@Url.Action("Create", "Invoice")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Create Invoice">
                            <i class="fas fa-file-invoice-dollar w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Create Invoice</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Invoice")" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Invoice List">
                            <i class="fas fa-list w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Invoice List</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Details", "Invoice", new { id = sampleInvoiceId })" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="View Sample Invoice">
                            <i class="fas fa-eye w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">View Invoice (Sample)</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("DownloadPdf", "Invoice", new { id = sampleInvoiceId })" class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-blue-50 dark:hover:bg-gray-700 hover:text-blue-600 transition-colors group" title="Download Sample PDF">
                            <i class="fas fa-file-pdf w-5 text-center text-gray-500 group-hover:text-blue-600 flex-shrink-0"></i>
                            <span class="sidebar-text text-sm font-medium whitespace-nowrap overflow-hidden">Download PDF (Sample)</span>
                        </a>
                    </li>
                </ul>
            </div>
        }

    </div>
</aside>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebar-toggle');
        const sidebarTexts = document.querySelectorAll('.sidebar-text');
        const sidebarHeaders = document.querySelectorAll('.sidebar-header');

        // Check local storage
        const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
        if (isCollapsed) {
            collapseSidebar();
        }

        toggleBtn.addEventListener('click', function() {
            if (sidebar.classList.contains('w-64')) {
                collapseSidebar();
                localStorage.setItem('sidebar-collapsed', 'true');
            } else {
                expandSidebar();
                localStorage.setItem('sidebar-collapsed', 'false');
            }
        });

        function collapseSidebar() {
            sidebar.classList.remove('w-64');
            sidebar.classList.add('w-20');
            
            sidebarTexts.forEach(el => el.classList.add('hidden'));
            sidebarHeaders.forEach(el => el.classList.add('hidden'));
        }

        function expandSidebar() {
            sidebar.classList.remove('w-20');
            sidebar.classList.add('w-64');

            sidebarTexts.forEach(el => el.classList.remove('hidden'));
            sidebarHeaders.forEach(el => el.classList.remove('hidden'));
        }
    });
</script>